# Copy this file to .dev.vars and fill in your actual values for local Miniflare runs
# .dev.vars is gitignored and should never be committed

# Telegram Bot Token from @BotFather
BOT_TOKEN=your_telegram_bot_token_here

# Secret token for Telegram webhook authentication
# Set via Telegram setWebhook API; use this same value to verify incoming requests
WEBHOOK_SECRET=your_webhook_secret_here
